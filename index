t: \"Se não reconhecer o símbolo, escolha \\\"Não sei qual é\\\".\", list: \"dashLight\", field: \"dashLight\" },\n  q_context: { title: \"Quando isso acontece?\", hint: \"Descreva o momento em que você nota o problema.\", list: \"context\", field: \"context\" },\n  q_urgency: { title: \"Quando você pretende resolver?\", hint: \"Assim a oficina organiza a agenda do atendimento.\", list: \"urgency\", field: \"urgency\" }\n};\n\nconst DRAFT_KEY = \"zecar_draft\";\nconst ATTR_KEY = \"zecar_attribution\";\nconst LEADS_KEY = \"oficina_leads\";\n\nfunction pad(n) { return String(n).padStart(2, \"0\"); }\n\nfunction generateLeadId(date) {\n  const d = date || new Date();\n  const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\";\n  let suffix = \"\";\n  for (let i = 0; i < 3; i++) suffix += chars[Math.floor(Math.random() * chars.length)];\n  return \"OF-\" + pad(d.getDate()) + pad(d.getMonth() + 1) + String(d.getFullYear()).slice(-2)\n    + \"-\" + pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds()) + \"-\" + suffix;\n}\n\nfunction safeStorage(kind) {\n  try { return kind === \"session\" ? window.sessionStorage : window.localStorage; }\n  catch (e) { return null; }\n}\n\nfunction captureTrafficSource() {\n  const session = safeStorage(\"session\");\n  if (session) {\n    try {\n      const saved = session.getItem(ATTR_KEY);\n      if (saved) return JSON.parse(saved);\n    } catch (e) {}\n  }\n  const params = new URLSearchParams(window.location.search);\n  const keys = [\"utm_source\", \"utm_medium\", \"utm_campaign\", \"utm_content\", \"fbclid\", \"gclid\", \"ttclid\", \"msclkid\"];\n  const data = {};\n  keys.forEach((k) => { const v = params.get(k); if (v) data[k] = v; });\n  if (!Object.keys(data).length) {\n    let ref = \"\";\n    try { ref = document.referrer ? new URL(document.referrer).hostname.replace(/^www\\./, \"\") : \"\"; } catch (e) {}\n    data.referrer = ref;\n  }\n  if (session) { try { session.setItem(ATTR_KEY, JSON.stringify(data)); } catch (e) {} }\n  return data;\n}\n\nfunction resolveSourceLabel(attr) {\n  if (!attr) return \"direct\";\n  if (attr.utm_source) return attr.utm_source;\n  if (attr.fbclid) return \"facebook\";\n  if (attr.gclid) return \"google\";\n  if (attr.ttclid) return \"tiktok\";\n  if (attr.msclkid) return \"bing\";\n  if (attr.referrer) return attr.referrer;\n  return \"direct\";\n}\n\nfunction trackEvent(name, payload) {\n  try {\n    if (window.dataLayer && typeof window.dataLayer.push === \"function\") {\n      window.dataLayer.push(Object.assign({ event: name }, payload || {}));\n    }\n  } catch (e) {}\n}\n\nfunction createLeadRepository(endpoint) {\n  function toLocal(lead) {\n    const store = safeStorage(\"local\");\n    if (!store) return \"none\";\n    try {\n      const list = JSON.parse(store.getItem(LEADS_KEY) || \"[]\");\n      list.push(lead);\n      store.setItem(LEADS_KEY, JSON.stringify(list));\n      return \"local\";\n    } catch (e) { return \"none\"; }\n  }\n  return {\n    save: async function (lead) {\n      if (endpoint) {\n        try {\n          const res = await fetch(endpoint, {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify(lead)\n          });\n          if (res.ok) return \"remote\";\n        } catch (e) {}\n      }\n      return toLocal(lead);\n    }\n  };\n}\n\nclass Component extends DCLogic {\n  state = { screen: \"landing\", answers: {}, error: \"\", leadId: \"\", whatsappUrl: \"\" };\n\n  draft = { problemOther: \"\", contextOther: \"\", brand: \"\", model: \"\", year: \"\", location: \"\", name: \"\" };\n\n  componentDidMount() {\n    this.attribution = captureTrafficSource();\n    const session = safeStorage(\"session\");\n    if (session) {\n      try {\n        const saved = JSON.parse(session.getItem(DRAFT_KEY) || \"null\");\n        if (saved && saved.draft) {\n          this.draft = Object.assign(this.draft, saved.draft);\n          this.setState({ answers: saved.answers || {} });\n        }\n      } catch (e) {}\n    }\n  }\n\n  persistDraft(answers) {\n    const session = safeStorage(\"session\");\n    if (!session) return;\n    try {\n      session.setItem(DRAFT_KEY, JSON.stringify({ draft: this.draft, answers: answers || this.state.answers }));\n    } catch (e) {}\n  }\n\n  mutateSilently(field, value) {\n    this.draft[field] = value;\n    this.persistDraft();\n  }\n\n  steps() {\n    const p = this.state.answers.problem;\n    const list = [\"q_problem\"];\n    if (p === \"noise\") list.push(\"q_noise_where\", \"q_noise_when\");\n    else if (p === \"light\") list.push(\"q_light\");\n    else if (p) list.push(\"q_context\");\n    list.push(\"vehicle\", \"location\", \"q_urgency\", \"name\", \"review\");\n    return list;\n  }\n\n  go(screen) {\n    this.setState({ screen, error: \"\" });\n    window.scrollTo(0, 0);\n  }\n\n  startDiagnostic = () => {\n    trackEvent(\"zecar_diagnostic_start\");\n    this.go(\"q_problem\");\n  };\n\n  goBack = () => {\n    const screen = this.state.screen;\n    if (screen === \"success\") { this.go(\"review\"); return; }\n    const list = this.steps();\n    const i = list.indexOf(screen);\n    if (i <= 0) { this.go(\"landing\"); return; }\n    this.go(list[i - 1]);\n  };\n\n  advance = () => {\n    const list = this.steps();\n    const i = list.indexOf(this.state.screen);\n    const next = i >= 0 && i < list.length - 1 ? list[i + 1] : \"review\";\n    this.go(next);\n  };\n\n  selectOption = (field, opt) => {\n    const answers = Object.assign({}, this.state.answers, { [field]: opt.value });\n    this.persistDraft(answers);\n    trackEvent(\"zecar_answer\", { field: field });\n    if (opt.freeText) {\n      this.setState({ answers, error: \"\" });\n      return;\n    }\n    this.setState({ answers, error: \"\" });\n    setTimeout(() => {\n      const list = this.steps();\n      const i = list.indexOf(this.state.screen);\n      const next = i >= 0 && i < list.length - 1 ? list[i + 1] : \"review\";\n      this.go(next);\n    }, 170);\n  };\n\n  continueFromFreeText = () => {\n    const screen = this.state.screen;\n    const key = screen === \"q_problem\" ? \"problemOther\" : \"contextOther\";\n    if (!String(this.draft[key] || \"\").trim()) {\n      this.setState({ error: \"Escreva rapidamente o que está acontecendo.\" });\n      return;\n    }\n    this.advance();\n  };\n\n  submitVehicle = () => {\n    if (!String(this.draft.brand || \"\").trim() || !String(this.draft.model || \"\").trim()) {\n      this.setState({ error: \"Informe a marca e o modelo do veículo.\" });\n      return;\n    }\n    trackEvent(\"zecar_answer\", { field: \"vehicle\" });\n    this.advance();\n  };\n\n  submitLocation = () => {\n    if (!String(this.draft.location || \"\").trim()) {\n      this.setState({ error: \"Informe seu bairro ou cidade.\" });\n      return;\n    }\n    trackEvent(\"zecar_answer\", { field: \"location\" });\n    this.advance();\n  };\n\n  submitName = () => {\n    if (!String(this.draft.name || \"\").trim()) {\n      this.setState({ error: \"Informe como podemos te chamar.\" });\n      return;\n    }\n    trackEvent(\"zecar_answer\", { field: \"name\" });\n    this.advance();\n  };\n\n  problemLabel() {\n    const a = this.state.answers;\n    if (a.problem === \"other\") return String(this.draft.problemOther || \"\").trim() || \"Outro problema\";\n    const found = OPTIONS.problem.find((o) => o.value === a.problem);\n    return found ? found.label : \"\";\n  }\n\n  vehicleLine() {\n    return [this.draft.brand, this.draft.model, this.draft.year]\n      .map((v) => String(v || \"\").trim()).filter(Boolean).join(\" \");\n  }\n\n  detailLines() {\n    const a = this.state.answers;\n    const lines = [];\n    if (a.problem === \"noise\") {\n      if (a.noiseWhere) lines.push(\"Local do barulho: \" + a.noiseWhere);\n      if (a.noiseWhen) lines.push(\"Quando acontece: \" + a.noiseWhen);\n    } else if (a.problem === \"light\") {\n      if (a.dashLight) lines.push(\"Luz no painel: \" + a.dashLight);\n    } else if (a.problem) {\n      if (a.context && a.context !== \"__free\") lines.push(\"Quando acontece: \" + a.context);\n      const free = String(this.draft.contextOther || \"\").trim();\n      if (free) lines.push(\"Detalhes: \" + free);\n    }\n    return lines;\n  }\n\n  buildWhatsAppMessage(leadId) {\n    const a = this.state.answers;\n    const name = String(this.draft.name || \"\").trim();\n    const parts = [];\n    parts.push(\"Olá! Meu nome é *\" + name + \"*, fiz o diagnóstico rápido pelo site da ZeCar e gostaria de agendar uma avaliação.\");\n\n    let problemBlock = \"🔧 *Problema:* \" + this.problemLabel();\n    const details = this.detailLines();\n    if (details.length) problemBlock += \"\\n\" + details.join(\"\\n\");\n    parts.push(problemBlock);\n\n    const vehicle = this.vehicleLine();\n    if (vehicle) parts.push(\"📋 *Veículo:* \" + vehicle);\n\n    const loc = String(this.draft.location || \"\").trim();\n    if (loc) parts.push(\"📍 *Localização:* \" + loc);\n\n    if (a.urgency) parts.push(\"🕒 *Urgência:* \" + a.urgency);\n\n    parts.push(\"Fico no aguardo do retorno de vocês. Obrigado!\");\n\n    let footer = \"_Ref.: \" + leadId + \" · origem: \" + resolveSourceLabel(this.attribution);\n    if (this.attribution && this.attribution.utm_campaign) footer += \" · campanha: \" + this.attribution.utm_campaign;\n    footer += \"_\";\n    parts.push(footer);\n\n    return parts.join(\"\\n\\n\");\n  }\n\n  buildWhatsAppUrl(leadId) {\n    const number = String(this.props.whatsappNumber || \"5561992630289\").replace(/\\D/g, \"\");\n    return \"https://wa.me/\" + number + \"?text=\" + encodeURIComponent(this.buildWhatsAppMessage(leadId));\n  }\n\n  sendToWhatsapp = () => {\n    if (this.sending) return;\n    this.sending = true;\n    const now = new Date();\n    const leadId = this.state.leadId || generateLeadId(now);\n    const url = this.buildWhatsAppUrl(leadId);\n    const lead = {\n      leadId: leadId,\n      createdAt: now.toISOString(),\n      answers: Object.assign({}, this.state.answers, {\n        problemOther: this.draft.problemOther,\n        contextOther: this.draft.contextOther\n      }),\n      vehicle: { brand: this.draft.brand, model: this.draft.model, year: this.draft.year },\n      location: this.draft.location,\n      name: this.draft.name,\n      attribution: this.attribution || {},\n      source: resolveSourceLabel(this.attribution)\n    };\n    const repo = createLeadRepository(this.props.leadsEndpoint || \"\");\n    Promise.resolve(repo.save(lead)).catch(function () {});\n    trackEvent(\"zecar_whatsapp_submit\", { lead_id: leadId });\n    this.setState({ leadId: leadId, whatsappUrl: url, screen: \"success\" });\n    window.scrollTo(0, 0);\n    setTimeout(() => {\n      this.sending = false;\n      window.open(url, \"_blank\", \"noopener\");\n    }, 120);\n  };\n\n  reopenWhatsapp = () => {\n    if (this.state.whatsappUrl) window.open(this.state.whatsappUrl, \"_blank\", \"noopener\");\n  };\n\n  restart = () => {\n    this.draft = { problemOther: \"\", contextOther: \"\", brand: \"\", model: \"\", year: \"\", location: \"\", name: \"\" };\n    const session = safeStorage(\"session\");\n    if (session) { try { session.removeItem(DRAFT_KEY); } catch (e) {} }\n    this.setState({ screen: \"landing\", answers: {}, error: \"\", leadId: \"\", whatsappUrl: \"\" });\n    window.scrollTo(0, 0);\n  };\n\n  optionStyle(active) {\n    return {\n      width: \"100%\",\n      minHeight: \"56px\",\n      display: \"flex\",\n      alignItems: \"center\",\n      gap: \"12px\",\n      padding: \"15px 16px\",\n      textAlign: \"left\",\n      background: active ? \"#FFF3DC\" : \"#FFFCF6\",\n      border: active ? \"2px solid #F4A81D\" : \"1px solid rgba(23,20,13,0.13)\",\n      borderRadius: \"14px\",\n      color: \"#17140D\",\n      fontSize: \"15.5px\",\n      fontWeight: 500,\n      lineHeight: 1.4,\n      cursor: \"pointer\"\n    };\n  }\n\n  markStyle(active) {\n    return {\n      flexShrink: 0,\n      width: \"20px\",\n      height: \"20px\",\n      borderRadius: \"50%\",\n      border: active ? \"6px solid #F4A81D\" : \"2px solid rgba(23,20,13,0.28)\",\n      background: \"transparent\",\n      transition: \"border .18s ease\"\n    };\n  }\n\n  reviewRows() {\n    const a = this.state.answers;\n    const rows = [];\n    const details = this.detailLines();\n    rows.push({ label: \"Problema relatado\", value: this.problemLabel() + (details.length ? \" — \" + details.join(\" · \") : \"\") });\n    const vehicle = this.vehicleLine();\n    if (vehicle) rows.push({ label: \"Veículo\", value: vehicle });\n    const loc = String(this.draft.location || \"\").trim();\n    if (loc) rows.push({ label: \"Localização\", value: loc });\n    if (a.urgency) rows.push({ label: \"Urgência\", value: a.urgency });\n    const name = String(this.draft.name || \"\").trim();\n    if (name) rows.push({ label: \"Nome\", value: name });\n    return rows;\n  }\n\n  renderVals() {\n    const screen = this.state.screen;\n    const a = this.state.answers;\n    const q = QUESTIONS[screen];\n    const list = this.steps();\n    const idx = list.indexOf(screen);\n    const total = list.length;\n    const pct = idx >= 0 ? Math.round(((idx + 1) / total) * 100) : 0;\n\n    let options = [];\n    let showFreeText = false;\n    let freeTextLabel = \"\";\n    let freeTextValue = \"\";\n    if (q) {\n      const defs = OPTIONS[q.list];\n      const current = a[q.field];\n      options = defs.map((opt) => ({\n        label: opt.label,\n        style: this.optionStyle(current === opt.value),\n        markStyle: this.markStyle(current === opt.value),\n        onClick: () => this.selectOption(q.field, opt)\n      }));\n      const activeDef = defs.find((o) => o.value === current);\n      if (activeDef && activeDef.freeText) {\n        showFreeText = true;\n        if (screen === \"q_problem\") {\n          freeTextLabel = \"Conte rapidamente o que está acontecendo\";\n          freeTextValue = this.draft.problemOther;\n        } else {\n          freeTextLabel = \"Descreva com suas palavras\";\n          freeTextValue = this.draft.contextOther;\n        }\n      }\n    }\n\n    const isQuestion = !!q;\n    const isVehicle = screen === \"vehicle\";\n    const isLocation = screen === \"location\";\n    const isName = screen === \"name\";\n    const isReview = screen === \"review\";\n    const isSuccess = screen === \"success\";\n\n    return {\n      isLanding: screen === \"landing\",\n      isQuestion: isQuestion,\n      isVehicle: isVehicle,\n      isLocation: isLocation,\n      isName: isName,\n      isReview: isReview,\n      isSuccess: isSuccess,\n      showHeader: screen !== \"landing\" && screen !== \"success\",\n      showProgress: (this.props.showProgressBar ?? true) && idx >= 0,\n      stepLabel: idx >= 0 ? \"Etapa \" + (idx + 1) + \" de \" + total : \"\",\n      progressStyle: \"height:100%;width:\" + pct + \"%;background:#F4A81D;border-radius:999px;transition:width .35s ease;\",\n\n      questionTitle: q ? q.title : \"\",\n      questionHint: q ? q.hint : \"\",\n      options: options,\n      showFreeText: showFreeText,\n      freeTextLabel: freeTextLabel,\n      freeTextValue: freeTextValue,\n      onFreeText: (e) => this.mutateSilently(screen === \"q_problem\" ? \"problemOther\" : \"contextOther\", e.target.value),\n      continueFromFreeText: this.continueFromFreeText,\n\n      brand: this.draft.brand,\n      model: this.draft.model,\n      year: this.draft.year,\n      location: this.draft.location,\n      name: this.draft.name,\n      onBrand: (e) => this.mutateSilently(\"brand\", e.target.value),\n      onModel: (e) => this.mutateSilently(\"model\", e.target.value),\n      onYear: (e) => this.mutateSilently(\"year\", e.target.value),\n      onLocation: (e) => this.mutateSilently(\"location\", e.target.value),\n      onName: (e) => this.mutateSilently(\"name\", e.target.value),\n      submitVehicle: this.submitVehicle,\n      submitLocation: this.submitLocation,\n      submitName: this.submitName,\n\n      hasError: !!this.state.error,\n      errorMessage: this.state.error,\n\n      reviewRows: this.reviewRows(),\n      sendToWhatsapp: this.sendToWhatsapp,\n      leadId: this.state.leadId,\n      reopenWhatsapp: this.reopenWhatsapp,\n      restart: this.restart,\n\n      startDiagnostic: this.startDiagnostic,\n      goBack: this.goBack\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
