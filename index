\"{{ isLanding }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"display:flex;flex-direction:column;align-items:center;text-align:center;animation:zcFade .5s ease both;\">\n        <div style=\"width:112px;height:112px;border-radius:50%;overflow:hidden;border:2px solid rgba(244,168,29,0.35);margin-bottom:22px;animation:zcPop .55s cubic-bezier(.2,.8,.2,1) both;\">\n          <img src=\"fbbb5530-37cf-49b1-87f6-6b6291c74870\" alt=\"ZeCar\" style=\"width:100%;height:100%;object-fit:cover;object-position:center;display:block;transform:scale(1.14);\">\n        <\u002Fdiv>\n        <h1 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(28px,8vw,34px);line-height:1.15;margin:0 0 12px;color:#FFF8EC;text-wrap:balance;\">Seu carro deu sinal? Organize o problema em 1 minuto.<\u002Fh1>\n        <p style=\"font-size:16px;line-height:1.6;color:#8F8877;margin:0 0 26px;\">Responda algumas perguntas rápidas sobre o que você percebeu. Nosso mecânico recebe tudo organizado e já te chama no WhatsApp.<\u002Fp>\n\n        <div style=\"width:100%;display:flex;flex-direction:column;gap:12px;margin-bottom:28px;text-align:left;\">\n          <div style=\"display:flex;align-items:center;gap:12px;\">\n            <span style=\"flex-shrink:0;width:26px;height:26px;border-radius:50%;background:rgba(244,168,29,0.16);color:#F4A81D;font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center;\">1<\u002Fspan>\n            <span style=\"font-size:15px;font-weight:500;color:#FFF8EC;\">Você descreve o sintoma, sem termos técnicos<\u002Fspan>\n          <\u002Fdiv>\n          <div style=\"display:flex;align-items:center;gap:12px;\">\n            <span style=\"flex-shrink:0;width:26px;height:26px;border-radius:50%;background:rgba(244,168,29,0.16);color:#F4A81D;font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center;\">2<\u002Fspan>\n            <span style=\"font-size:15px;font-weight:500;color:#FFF8EC;\">Informa veículo, bairro e quando quer resolver<\u002Fspan>\n          <\u002Fdiv>\n          <div style=\"display:flex;align-items:center;gap:12px;\">\n            <span style=\"flex-shrink:0;width:26px;height:26px;border-radius:50%;background:rgba(244,168,29,0.16);color:#F4A81D;font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center;\">3<\u002Fspan>\n            <span style=\"font-size:15px;font-weight:500;color:#FFF8EC;\">Abrimos o WhatsApp com o resumo já escrito<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <button sc-camel-on-click=\"{{ startDiagnostic }}\" style=\"width:100%;min-height:56px;padding:18px 20px;background:#22C55E;color:#FFFFFF;font-family:'Oswald',sans-serif;font-weight:600;font-size:18px;letter-spacing:0.02em;border:none;border-radius:14px;cursor:pointer;text-shadow:0 1px 2px rgba(0,0,0,0.25);box-shadow:0 10px 26px rgba(34,197,94,0.32);\" style-hover=\"background:#16A34A;\">Fazer diagnóstico rápido<\u002Fbutton>\n        <p style=\"font-size:13px;color:#8F8877;margin:12px 0 26px;\">Gratuito e sem compromisso. Leva menos de 1 minuto.<\u002Fp>\n\n        <div style=\"width:100%;display:flex;flex-wrap:wrap;gap:8px;justify-content:center;\">\n          <span style=\"background:#F4A81D;color:#17140D;font-size:12.5px;font-weight:600;padding:8px 13px;border-radius:999px;\">Atendimento local<\u002Fspan>\n          <span style=\"background:#F4A81D;color:#17140D;font-size:12.5px;font-weight:600;padding:8px 13px;border-radius:999px;\">Orçamento com a oficina<\u002Fspan>\n          <span style=\"background:#F4A81D;color:#17140D;font-size:12.5px;font-weight:600;padding:8px 13px;border-radius:999px;\">Atendimento por WhatsApp<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ showHeader }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:18px;\">\n        <button sc-camel-on-click=\"{{ goBack }}\" aria-label=\"Voltar\" style=\"flex-shrink:0;width:44px;height:44px;border-radius:12px;background:transparent;border:1px solid rgba(255,248,236,0.18);color:#FFF8EC;cursor:pointer;display:flex;align-items:center;justify-content:center;\" style-hover=\"background:rgba(255,248,236,0.08)\">\n          <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><\u002Fpath><\u002Fsvg>\n        <\u002Fbutton>\n        <div style=\"flex:1;\">\n          <sc-if value=\"{{ showProgress }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;\">\n              <span style=\"font-family:'Oswald',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#8F8877;\">{{ stepLabel }}<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"width:100%;height:5px;border-radius:999px;background:rgba(255,248,236,0.12);overflow:hidden;\">\n              <div style=\"{{ progressStyle }}\"><\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isQuestion }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"animation:zcFade .35s ease both;\">\n        <h2 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(23px,6.4vw,27px);line-height:1.2;margin:0 0 8px;color:#FFF8EC;text-wrap:pretty;\">{{ questionTitle }}<\u002Fh2>\n        <p style=\"font-size:14.5px;line-height:1.55;color:#8F8877;margin:0 0 20px;\">{{ questionHint }}<\u002Fp>\n        <div style=\"display:flex;flex-direction:column;gap:10px;\">\n          <sc-for list=\"{{ options }}\" as=\"opt\" hint-placeholder-count=\"4\">\n            <button sc-camel-on-click=\"{{ opt.onClick }}\" style=\"{{ opt.style }}\">\n              <span style=\"{{ opt.markStyle }}\"><\u002Fspan>\n              <span style=\"flex:1;\">{{ opt.label }}<\u002Fspan>\n            <\u002Fbutton>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n        <sc-if value=\"{{ showFreeText }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"margin-top:16px;\">\n            <label for=\"zc-free\" style=\"display:block;font-size:13.5px;font-weight:600;color:#FFF8EC;margin-bottom:8px;\">{{ freeTextLabel }}<\u002Flabel>\n            <textarea id=\"zc-free\" sc-camel-on-change=\"{{ onFreeText }}\" sc-camel-default-value=\"{{ freeTextValue }}\" rows=\"3\" placeholder=\"Ex: faz um estalo quando passo em lombada\" style=\"width:100%;padding:14px;background:#FFFCF6;border:1px solid rgba(23,20,13,0.13);border-radius:12px;color:#17140D;font-size:15.5px;line-height:1.5;resize:vertical;\"><\u002Ftextarea>\n            <button sc-camel-on-click=\"{{ continueFromFreeText }}\" style=\"width:100%;min-height:52px;margin-top:12px;padding:15px 20px;background:#F4A81D;color:#17140D;font-family:'Oswald',sans-serif;font-weight:600;font-size:17px;border:none;border-radius:14px;cursor:pointer;\" style-hover=\"background:#D98D0C\">Continuar<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isVehicle }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"animation:zcFade .35s ease both;\">\n        <h2 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(23px,6.4vw,27px);line-height:1.2;margin:0 0 8px;color:#FFF8EC;\">Qual é o seu veículo?<\u002Fh2>\n        <p style=\"font-size:14.5px;line-height:1.55;color:#8F8877;margin:0 0 20px;\">Ajuda o mecânico a já separar as peças e ferramentas certas.<\u002Fp>\n        <div style=\"display:flex;flex-direction:column;gap:14px;\">\n          <div>\n            <label for=\"zc-brand\" style=\"display:block;font-size:13.5px;font-weight:600;color:#FFF8EC;margin-bottom:7px;\">Marca<\u002Flabel>\n            <input id=\"zc-brand\" type=\"text\" sc-camel-on-change=\"{{ onBrand }}\" sc-camel-default-value=\"{{ brand }}\" placeholder=\"Fiat, Volkswagen, Toyota...\" sc-camel-auto-complete=\"off\" style=\"width:100%;min-height:52px;padding:14px;background:#FFFCF6;border:1px solid rgba(23,20,13,0.13);border-radius:12px;color:#17140D;font-size:16px;\">\n          <\u002Fdiv>\n          <div>\n            <label for=\"zc-model\" style=\"display:block;font-size:13.5px;font-weight:600;color:#FFF8EC;margin-bottom:7px;\">Modelo<\u002Flabel>\n            <input id=\"zc-model\" type=\"text\" sc-camel-on-change=\"{{ onModel }}\" sc-camel-default-value=\"{{ model }}\" placeholder=\"Uno, Gol, Corolla...\" sc-camel-auto-complete=\"off\" style=\"width:100%;min-height:52px;padding:14px;background:#FFFCF6;border:1px solid rgba(23,20,13,0.13);border-radius:12px;color:#17140D;font-size:16px;\">\n          <\u002Fdiv>\n          <div>\n            <label for=\"zc-year\" style=\"display:block;font-size:13.5px;font-weight:600;color:#FFF8EC;margin-bottom:7px;\">Ano <span style=\"color:#8F8877;font-weight:400;\">(opcional)<\u002Fspan><\u002Flabel>\n            <input id=\"zc-year\" type=\"text\" sc-camel-input-mode=\"numeric\" sc-camel-on-change=\"{{ onYear }}\" sc-camel-default-value=\"{{ year }}\" placeholder=\"2014\" sc-camel-auto-complete=\"off\" style=\"width:100%;min-height:52px;padding:14px;background:#FFFCF6;border:1px solid rgba(23,20,13,0.13);border-radius:12px;color:#17140D;font-size:16px;\">\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <sc-if value=\"{{ hasError }}\" hint-placeholder-val=\"{{ false }}\">\n          <p style=\"font-size:13.5px;font-weight:600;color:#E6491D;margin:12px 0 0;\">{{ errorMessage }}<\u002Fp>\n        <\u002Fsc-if>\n        <button sc-camel-on-click=\"{{ submitVehicle }}\" style=\"width:100%;min-height:56px;margin-top:20px;padding:17px 20px;background:#F4A81D;color:#17140D;font-family:'Oswald',sans-serif;font-weight:600;font-size:18px;border:none;border-radius:14px;cursor:pointer;\" style-hover=\"background:#D98D0C\">Continuar<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isLocation }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"animation:zcFade .35s ease both;\">\n        <h2 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(23px,6.4vw,27px);line-height:1.2;margin:0 0 8px;color:#FFF8EC;\">Onde você está?<\u002Fh2>\n        <p style=\"font-size:14.5px;line-height:1.55;color:#8F8877;margin:0 0 20px;\">Só o bairro ou a cidade. Serve para indicarmos o atendimento mais perto.<\u002Fp>\n        <label for=\"zc-loc\" style=\"display:block;font-size:13.5px;font-weight:600;color:#FFF8EC;margin-bottom:7px;\">Bairro ou cidade<\u002Flabel>\n        <input id=\"zc-loc\" type=\"text\" sc-camel-on-change=\"{{ onLocation }}\" sc-camel-default-value=\"{{ location }}\" placeholder=\"Taguatinga, Ceilândia, Águas Claras...\" sc-camel-auto-complete=\"off\" style=\"width:100%;min-height:52px;padding:14px;background:#FFFCF6;border:1px solid rgba(23,20,13,0.13);border-radius:12px;color:#17140D;font-size:16px;\">\n        <sc-if value=\"{{ hasError }}\" hint-placeholder-val=\"{{ false }}\">\n          <p style=\"font-size:13.5px;font-weight:600;color:#E6491D;margin:12px 0 0;\">{{ errorMessage }}<\u002Fp>\n        <\u002Fsc-if>\n        <button sc-camel-on-click=\"{{ submitLocation }}\" style=\"width:100%;min-height:56px;margin-top:20px;padding:17px 20px;background:#F4A81D;color:#17140D;font-family:'Oswald',sans-serif;font-weight:600;font-size:18px;border:none;border-radius:14px;cursor:pointer;\" style-hover=\"background:#D98D0C\">Continuar<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isName }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"animation:zcFade .35s ease both;\">\n        <h2 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(23px,6.4vw,27px);line-height:1.2;margin:0 0 8px;color:#FFF8EC;\">Como podemos te chamar?<\u002Fh2>\n        <p style=\"font-size:14.5px;line-height:1.55;color:#8F8877;margin:0 0 20px;\">Última etapa. Depois disso o resumo fica pronto.<\u002Fp>\n        <label for=\"zc-name\" style=\"display:block;font-size:13.5px;font-weight:600;color:#FFF8EC;margin-bottom:7px;\">Seu nome<\u002Flabel>\n        <input id=\"zc-name\" type=\"text\" sc-camel-on-change=\"{{ onName }}\" sc-camel-default-value=\"{{ name }}\" placeholder=\"Seu primeiro nome\" sc-camel-auto-complete=\"given-name\" style=\"width:100%;min-height:52px;padding:14px;background:#FFFCF6;border:1px solid rgba(23,20,13,0.13);border-radius:12px;color:#17140D;font-size:16px;\">\n        <sc-if value=\"{{ hasError }}\" hint-placeholder-val=\"{{ false }}\">\n          <p style=\"font-size:13.5px;font-weight:600;color:#E6491D;margin:12px 0 0;\">{{ errorMessage }}<\u002Fp>\n        <\u002Fsc-if>\n        <button sc-camel-on-click=\"{{ submitName }}\" style=\"width:100%;min-height:56px;margin-top:20px;padding:17px 20px;background:#F4A81D;color:#17140D;font-family:'Oswald',sans-serif;font-weight:600;font-size:18px;border:none;border-radius:14px;cursor:pointer;\" style-hover=\"background:#D98D0C\">Ver meu resumo<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isReview }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"animation:zcFade .35s ease both;\">\n        <h2 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(23px,6.4vw,27px);line-height:1.2;margin:0 0 8px;color:#FFF8EC;\">Confira antes de enviar<\u002Fh2>\n        <p style=\"font-size:14.5px;line-height:1.55;color:#8F8877;margin:0 0 20px;\">É isso que o mecânico vai receber no WhatsApp.<\u002Fp>\n\n        <div style=\"background:#FFFCF6;border-radius:16px;padding:6px 18px;margin-bottom:16px;\">\n          <sc-for list=\"{{ reviewRows }}\" as=\"row\" hint-placeholder-count=\"5\">\n            <div style=\"padding:14px 0;border-bottom:1px solid rgba(23,20,13,0.13);\">\n              <div style=\"font-family:'Oswald',sans-serif;font-size:11.5px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#8F8877;margin-bottom:5px;\">{{ row.label }}<\u002Fdiv>\n              <div style=\"font-size:15.5px;font-weight:500;line-height:1.5;color:#17140D;\">{{ row.value }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n\n        <div style=\"display:flex;gap:11px;background:rgba(230,73,29,0.1);border:1px solid rgba(230,73,29,0.35);border-radius:14px;padding:14px 15px;margin-bottom:20px;\">\n          <span style=\"flex-shrink:0;color:#E6491D;font-weight:700;font-size:15px;\">!<\u002Fspan>\n          <p style=\"font-size:13.5px;line-height:1.55;color:#FFF8EC;margin:0;\">Este resumo organiza o que você relatou. Ele não substitui a avaliação presencial do mecânico, que é quem identifica a causa real.<\u002Fp>\n        <\u002Fdiv>\n\n        <button sc-camel-on-click=\"{{ sendToWhatsapp }}\" style=\"width:100%;min-height:56px;padding:18px 20px;background:#22C55E;color:#FFFFFF;font-family:'Oswald',sans-serif;font-weight:600;font-size:18px;letter-spacing:0.02em;border:none;border-radius:14px;cursor:pointer;text-shadow:0 1px 2px rgba(0,0,0,0.25);box-shadow:0 10px 26px rgba(34,197,94,0.32);\" style-hover=\"background:#16A34A\">Enviar no WhatsApp<\u002Fbutton>\n        <p style=\"font-size:13px;color:#8F8877;text-align:center;margin:12px 0 0;\">O WhatsApp abre com a mensagem já escrita. Você só confirma o envio.<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isSuccess }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"text-align:center;animation:zcFade .4s ease both;padding-top:20px;\">\n        <div style=\"width:72px;height:72px;border-radius:50%;background:rgba(34,197,94,0.16);color:#22C55E;display:flex;align-items:center;justify-content:center;margin:0 auto 22px;animation:zcPop .5s cubic-bezier(.2,.8,.2,1) both;\">\n          <svg width=\"32\" height=\"32\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 13l4 4L19 7\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><\u002Fpath><\u002Fsvg>\n        <\u002Fdiv>\n        <h2 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(25px,7vw,30px);line-height:1.18;margin:0 0 12px;color:#FFF8EC;\">Diagnóstico enviado<\u002Fh2>\n        <p style=\"font-size:15.5px;line-height:1.6;color:#8F8877;margin:0 0 24px;\">Abrimos o WhatsApp da oficina com o seu resumo. Se a janela não abriu, use o botão abaixo.<\u002Fp>\n\n        <div style=\"background:#FFFCF6;border-radius:14px;padding:16px;margin-bottom:24px;\">\n          <div style=\"font-family:'Oswald',sans-serif;font-size:11.5px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#8F8877;margin-bottom:6px;\">Sua referência<\u002Fdiv>\n          <div style=\"font-family:'Oswald',sans-serif;font-size:19px;font-weight:600;color:#17140D;letter-spacing:0.02em;\">{{ leadId }}<\u002Fdiv>\n        <\u002Fdiv>\n\n        <button sc-camel-on-click=\"{{ reopenWhatsapp }}\" style=\"width:100%;min-height:56px;padding:17px 20px;background:#22C55E;color:#FFFFFF;font-family:'Oswald',sans-serif;font-weight:600;font-size:17px;border:none;border-radius:14px;cursor:pointer;text-shadow:0 1px 2px rgba(0,0,0,0.25);margin-bottom:11px;\" style-hover=\"background:#16A34A\">Reabrir WhatsApp<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ restart }}\" style=\"width:100%;min-height:52px;padding:15px 20px;background:transparent;color:#FFF8EC;font-family:'Oswald',sans-serif;font-weight:500;font-size:16px;border:1px solid rgba(255,248,236,0.22);border-radius:14px;cursor:pointer;\" style-hover=\"background:rgba(255,248,236,0.08)\">Começar novo diagnóstico<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n  <\u002Fdiv>\n\n  <div style=\"width:100%;max-width:480px;margin:0 auto;padding:0 20px 28px;\">\n    <p style=\"font-size:11.5px;line-height:1.6;color:#8F8877;text-align:center;margin:0;\">ZeCar · Diagnóstico orientativo. A causa do problema é definida pelo mecânico na avaliação presencial.<\u002Fp>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;whatsappNumber&quot;:{&quot;editor&quot;:&quot;text&quot;,&quot;default&quot;:&quot;5561992630289&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Integração&quot;},&quot;leadsEndpoint&quot;:{&quot;editor&quot;:&quot;text&quot;,&quot;default&quot;:&quot;&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Integração&quot;},&quot;showProgressBar&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Fluxo&quot;}}\">\nconst OPTIONS = {\n  problem: [\n    { value: \"noise\", label: \"Está fazendo barulho\" },\n    { value: \"light\", label: \"Luz acendeu no painel\" },\n    { value: \"power\", label: \"Carro perdeu força\" },\n    { value: \"leak\", label: \"Está vazando algo\" },\n    { value: \"heat\", label: \"Está esquentando\" },\n    { value: \"shake\", label: \"Está tremendo\" },\n    { value: \"brake\", label: \"Problema no freio\" },\n    { value: \"other\", label: \"Outro problema\", freeText: true }\n  ],\n  noiseWhere: [\n    { value: \"Motor\", label: \"No motor\" },\n    { value: \"Frente do carro\", label: \"Na frente do carro\" },\n    { value: \"Traseira do carro\", label: \"Na traseira do carro\" },\n    { value: \"Rodas\", label: \"Nas rodas\" },\n    { value: \"Embaixo do carro\", label: \"Embaixo do carro\" },\n    { value: \"Não sei identificar\", label: \"Não sei identificar\" }\n  ],\n  noiseWhen: [\n    { value: \"Ao ligar o carro\", label: \"Ao ligar o carro\" },\n    { value: \"Ao acelerar\", label: \"Ao acelerar\" },\n    { value: \"Ao frear\", label: \"Ao frear\" },\n    { value: \"Ao virar\", label: \"Ao virar\" },\n    { value: \"Ao passar em buraco\", label: \"Ao pass